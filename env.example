# ============================================
# Corridor Backend Configuration
# ============================================
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control

# ============================================
# FastAPI Configuration
# ============================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================
# JWT Configuration (REQUIRED)
# ============================================
# Use the Supabase JWT secret or generate a secure random string
JWT_SECRET=m1GcqEESd9DSnxVXXC+XM5mq8fLO1uqzniemRHPB5sHYG5Lz3Qt9lmvB8qHqTeICxz0K3qNPaXUyCxE5nCum7Q==
JWT_EXPIRE_MIN=43200

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# PostgreSQL connection string
# For Supabase: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# For local: postgresql+psycopg2://postgres:postgres@localhost:5432/corridor
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/corridor

# ============================================
# Supabase Configuration (Optional)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=invoices
USE_SUPABASE_AUTH=false

# ============================================
# WhatsApp Business API (REQUIRED)
# ============================================
WA_BASE_URL=https://graph.facebook.com/v19.0
WA_TOKEN=your_meta_token_here
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_TEMPLATE_LANG=en
WA_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ============================================
# Stripe Configuration (REQUIRED)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:5173/pay/success
STRIPE_CANCEL_URL=http://localhost:5173/pay/cancel

# ============================================
# M-Pesa Daraja Configuration (Optional)
# ============================================
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=123456
MPESA_ENV=sandbox

# ============================================
# SMTP Email Configuration (REQUIRED for Production)
# ============================================
# Zoho Mail Configuration for Corridor
SMTP_ENABLED=true
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=people@corridormoney.net
SMTP_PASSWORD=dw$pdM3g
FROM_EMAIL=people@corridormoney.net
FROM_NAME=Corridor Support

# ============================================
# Intersend Email Service (Optional - Alternative)
# ============================================
INTERSEND_API_KEY=your_intersend_api_key
INTERSEND_BASE_URL=https://api.intersend.io/v1
INTERSEND_FROM_EMAIL=noreply@corridormoney.net
INTERSEND_FROM_NAME=Corridor Bot

# ============================================
# Application URLs
# ============================================
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# ============================================
# Security & CORS
# ============================================
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Scheduler Configuration
# ============================================
REMINDER_HOUR=10
REMINDER_MINUTE=0
OVERDUE_HOUR=18
OVERDUE_MINUTE=0

# ============================================
# Internationalization
# ============================================
TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES

# ============================================
# Deployment Settings
# ============================================
HEALTH_CHECK_SECRET=your_health_check_secret
DOCS_ENABLED=true
LOG_LEVEL=INFO

# ============================================
# Deep Agent Configuration
# ============================================
AGENT_MODEL=anthropic:claude-sonnet-4-20250514
AGENT_ENABLE_PLANNING=true
AGENT_ENABLE_FILESYSTEM=true
AGENT_ENABLE_SUBAGENTS=true

# ============================================
# API Keys for Deep Agent (Optional)
# ============================================
# Set at least one for Deep Agent to work
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key 

# ============================================
# Multichain Custody (ETH L2 + Solana)
# ============================================
ETH_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-key
ETH_HOT_PRIVATE_KEY=0xyour_hex_private_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_HOT_PRIVATE_KEY=your_solana_private_key_base58
KEY_ENCRYPTION_SECRET=generate_a_fernet_key_for_storing_wallet_metadata

# ============================================
# Helius Configuration (Enhanced Solana APIs)
# ============================================
# Get your API key from: https://www.helius.dev/
# Helius provides enhanced Solana APIs with better performance and webhook support
HELIUS_API_KEY=your_helius_api_key_here
# Optional: Custom Helius RPC URL (auto-constructed from API key if not provided)
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key
# Optional: Webhook URL for real-time transaction notifications
# HELIUS_WEBHOOK_URL=https://your-app.com/api/webhooks/helius